{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Tutor's two windows may do: use the local database, reach AI models on this computer (any local port) and the two cloud APIs, start at login",
  "windows": [
    "main",
    "sticky"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "https://api.openai.com/*"
        },
        {
          "url": "https://api.anthropic.com/*"
        }
      ]
    }
  ]
}
